
.text
.globl main

main:
    // Initialize 32 x 32 matrix
    la t4, matrix

    li t0, 0          // row counter
    li a3, 32         // matrix dimension

init_row:
    li t1, 0          // column counter
    li t6, 1          // value starts at 1

init_column:
    sw t6, 0(t4)

    // Move matrix pointer forward by 4 bytes
    addi t4, t4, 4

    // Increase value by 1
    addi t6, t6, 1

    // Increase column counter by 1
    addi t1, t1, 1

    blt t1, a3, init_column

    // Increase row counter by 1
    addi t0, t0, 1

    blt t0, a3, init_row

    // Set up function arguments
    la a0, matrix
    li a1, 32
    li a2, 32
    la a4, sum

    jal ra, sum_columns

    la t0, sum

done:
    j done


// a0 = matrix pointer
// a1 = number of rows
// a2 = number of columns
// a4 = output array pointer

sum_columns:

    // Save registers
    addi sp, sp, -32
    sw s0, 0(sp)
    sw s1, 4(sp)
    sw s2, 8(sp)
    sw s3, 12(sp)
    sw s4, 16(sp)
    sw ra, 20(sp)

    // Save function arguments
    mv s0, a0          // matrix pointer
    mv s1, a1          // number of rows
    mv s2, a2          // number of columns
    mv s4, a4          // output array pointer

    // Calculate row size in bytes
    slli s3, s2, 2

    // Initialize output array to zero
    li t0, 0
    mv t5, s4

init_sum:
    beq t0, s2, init_done

    sw x0, 0(t5)

    // Move output pointer forward by 4
    addi t5, t5, 4

    // Increment column counter
    addi t0, t0, 1

    j init_sum

init_done:

    // Overall overflow flag (not used with hardware add)
    li t6, 0

    // Row counter
    li t0, 0

for_row:
    beq t0, s1, end

    // Start at beginning of current row
    mv t4, s0

    // Start at beginning of output array
    mv t5, s4

    // Column counter
    li t1, 0

for_column:
    beq t1, s2, next_row

    // Add matrix[row][column] to sum[column]
    lw t2, 0(t4)
    lw t3, 0(t5)
    add t3, t3, t2

    // Store updated column sum
    sw t3, 0(t5)

    // Move to next matrix element
    addi t4, t4, 4

    // Move to next output element
    addi t5, t5, 4

    // Increment column counter
    addi t1, t1, 1

    j for_column

next_row:

    // Move to beginning of next row
    add s0, s0, s3

    // Increment row counter
    addi t0, t0, 1

    j for_row

end:

    // Return output pointer
    mv a0, s4

    // Restore saved registers
    lw s0, 0(sp)
    lw s1, 4(sp)
    lw s2, 8(sp)
    lw s3, 12(sp)
    lw s4, 16(sp)
    lw ra, 20(sp)

    addi sp, sp, 32

    ret


.data

matrix: .space 4096
sum:    .space 128
