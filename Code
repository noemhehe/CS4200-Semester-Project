sum_columns:
    // receive matrix pointer in a0, nrows in a1, ncols in a2
    // use save registers
    addi sp, sp, -12
    sw s0, 8(sp)
    sw s1, 4(sp)
    sw s2, 0(sp)
    
    mv s0, a0
    mv s1, a1
    mv s2, a2
    
    // begin loop - column counter
    addi t1, x0, 0 // i = 0
    mv a5, s0 // original matrix pointer for reference
    for_column:
    beq s2, t1, end
    addi a3, x0, 0 // sum register
    // begin loop - row counter
    addi t0, x0, 0 // k = 0
    for_row:
        beq s1, t0, add_total
        lw a0, 0(s0)
        mv a1, a3
        j do_add
        mv a3, a0
        
        // increase matrix pointer by the number of columns; matrix will point at the next column entry
        mv a0, s0
        mv a1, s2
        j do_add
        mv s0, a0
        addi t0, t0, 1
        j for_row
        
    // save the column's sum to a sum array at a4
    add_total:
    sw a3, 0(a4)
    addi a4, a4, 4
    addi t1, t1, 1
    // get to the beginning of the next column
    addi a5, a5, 4
    mv s0, a5
    j for_column
    
    end:
    // reset save registers
    lw s0, 8(ap)
    lw s1, 4(sp)
    lw s2, 0(sp)
    addi sp, sp, 12
    // write -1 to the end of the sum array to signal the end
    addi t0, t0, -1
    sw t0, 0(a4)
    mv a0, a4

do_add:
    and   t2, t0, t1      
    xor   t0, t0, t1     
    slli  t1, t2, 1        
    bnez  t1, do_add 
