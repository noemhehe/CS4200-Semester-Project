sum_columns:
    // receive matrix pointer in a0, nrows in a1, ncols in a2
    // use save registers
    addi sp, sp, -12
    sw s0, 8(sp)
    sw s1, 4(sp)
    sw s2, 0(sp)
    lw s0, 0(a0)
    lw s1, 0(a1)
    lw s2, 0(a2)
    
    // begin loop - column counter
    addi t0, x0, 0 // i = 0
    for_column:
    // begin loop - row counter
    addi t1, x0, 0 // j = 0
    for_row:
    
    
    // reset save registers
    lw s0, 8(ap)
    lw s1, 4(sp)
    lw s2, 0(sp)
    addi sp, sp, 12

do_add:
    and   t2, t0, t1      
    xor   t0, t0, t1     
    slli  t1, t2, 1        
    bnez  t1, do_add 
